rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== YARDIMCI FONKSİYONLAR =====
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Kullanıcın kendi klasörü mü? (Email veya UID olabilir)
    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.token.email == userId || 
        request.auth.uid == userId
      );
    }

    // ===== POST MEDYALARI (Fotoğraf/Video) =====
    match /{folder}/{userId}/{fileName} {
      allow read: if isSignedIn();
      
      // Post fotoları, videoları veya profil fotoları için genel izin
      // folder.matches('postFoto.*') || folder == 'postVideolari' || folder == 'profilePhotos'
      allow write: if isSignedIn()
                   && isOwner(userId)
                   && request.resource.size < 50 * 1024 * 1024; // Genel 50MB sınırı
                   
      allow delete: if isOwner(userId);
    }

    // ===== VARSAYILAN: Her şeyi kapat =====
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
