rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unica Hafızası - Sadece ilgili kullanıcı
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Mevcut Uygulama Koleksiyonları - Genel erişime veya yetkiye göre aç
    match /postlar/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /Kullanicilar/{email} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == email;
    }
    
    // Diğer her şey için (varsayılanı engelle veya mevcut yapıya göre esnet)
    match /{document=**} {
       allow read, write: if request.auth != null;
    }
  }
}
